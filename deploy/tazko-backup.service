[Unit]
Description=Tazko nightly backup
After=tazko.service

[Service]
Type=oneshot
User=tazko
Group=tazko
ExecStart=/opt/tazko/current/tazko backup --data /var/lib/tazko/data --to /var/backups/tazko --keep-days 30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/tazko /var/backups/tazko
CapabilityBoundingSet=
SystemCallArchitectures=native
