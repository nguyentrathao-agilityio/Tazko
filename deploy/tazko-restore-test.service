[Unit]
Description=Tazko weekly restore test
After=tazko-backup.service

[Service]
Type=oneshot
User=tazko
Group=tazko
ExecStart=/opt/tazko/current/tazko backup verify --from /var/backups/tazko --data /var/lib/tazko/data --scratch /var/tmp
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/tazko
ReadOnlyPaths=/var/backups/tazko
CapabilityBoundingSet=
SystemCallArchitectures=native
