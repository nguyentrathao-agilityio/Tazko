{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "ask": [
      "Bash(sudo:*)",
      "Bash(systemctl:*)",
      "Bash(cloudflared:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(brew install:*)",
      "Bash(useradd:*)",
      "Bash(usermod:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-write.py\""
          }
        ]
      }
    ]
  }
}
