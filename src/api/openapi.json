{
 "openapi": "3.1.0",
 "info": {
  "title": "Tazko API",
  "version": "1",
  "description": "Send a token as Authorization: Bearer <token>. Personal tokens act as you and never go beyond your access; company tokens act as the owner who made them, only on the chosen projects. Scopes: read (GET only), write (cards, lists, comments, attachments), manage (also boards and project settings). Each token may make 120 requests a minute; over that the API answers 429 with Retry-After. Requests with a token need no CSRF header."
 },
 "servers": [
  {
   "url": "/"
  }
 ],
 "components": {
  "securitySchemes": {
   "token": {
    "type": "http",
    "scheme": "bearer"
   }
  },
  "schemas": {
   "NewBoard": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "background": {
      "type": "string"
     },
     "restricted": {
      "type": "boolean"
     },
     "template": {
      "type": "string"
     }
    },
    "required": [
     "name"
    ]
   },
   "BoardChange": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "background": {
      "type": "string"
     }
    }
   },
   "NewList": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string"
     }
    },
    "required": [
     "title"
    ]
   },
   "ListChange": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string"
     }
    }
   },
   "Move": {
    "type": "object",
    "properties": {
     "list_id": {
      "type": "integer"
     },
     "after": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   },
   "NewCards": {
    "type": "object",
    "properties": {
     "list_id": {
      "type": "integer"
     },
     "title": {
      "type": "string"
     },
     "titles": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "items": {
      "type": "array",
      "description": "Cards with their labels, people and due date, created together",
      "items": {
       "type": "object",
       "properties": {
        "title": {
         "type": "string"
        },
        "labels": {
         "type": "array",
         "items": {
          "type": "integer"
         }
        },
        "members": {
         "type": "array",
         "items": {
          "type": "integer"
         }
        },
        "due_at": {
         "type": [
          "integer",
          "null"
         ]
        }
       },
       "required": [
        "title"
       ]
      }
     },
     "top": {
      "type": "boolean"
     }
    },
    "required": [
     "list_id"
    ]
   },
   "CardChange": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string"
     },
     "start_at": {
      "type": [
       "integer",
       "null"
      ]
     },
     "due_at": {
      "type": [
       "integer",
       "null"
      ]
     },
     "done": {
      "type": "boolean"
     },
     "cover": {
      "type": [
       "string",
       "null"
      ]
     },
     "description_markdown": {
      "type": "string"
     },
     "description_html": {
      "type": "string"
     },
     "recurrence": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "daily",
       "weekdays",
       "weekly",
       "biweekly",
       "monthly",
       null
      ],
      "description": "How often the card repeats; needs a due date"
     },
     "tz_offset": {
      "type": "integer",
      "minimum": -840,
      "maximum": 840,
      "description": "Minutes east of UTC, used with done: true to work out the next date of a repeating card"
     }
    }
   },
   "On": {
    "type": "object",
    "properties": {
     "on": {
      "type": "boolean"
     }
    },
    "required": [
     "on"
    ]
   },
   "Comment": {
    "type": "object",
    "properties": {
     "body": {
      "type": "string"
     }
    },
    "required": [
     "body"
    ]
   },
   "FieldValue": {
    "type": "object",
    "properties": {
     "value": {}
    }
   },
   "Reaction": {
    "type": "object",
    "properties": {
     "emoji": {
      "enum": [
       "👍",
       "❤️",
       "🎉",
       "👀",
       "🚀",
       "✅"
      ]
     },
     "on": {
      "type": "boolean"
     }
    },
    "required": [
     "emoji",
     "on"
    ]
   },
   "NewPersonalToken": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "scope": {
      "enum": [
       "read",
       "write",
       "manage"
      ]
     },
     "projects": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "company": {
         "type": "string"
        },
        "project": {
         "type": "integer"
        }
       }
      }
     },
     "expires_in_days": {
      "type": "integer"
     }
    },
    "required": [
     "name",
     "scope"
    ]
   },
   "NewCompanyToken": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "scope": {
      "enum": [
       "read",
       "write",
       "manage"
      ]
     },
     "projects": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "expires_in_days": {
      "type": "integer"
     }
    },
    "required": [
     "name",
     "scope",
     "projects"
    ]
   },
   "SaveTemplate": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "description": {
      "type": "string"
     }
    },
    "required": [
     "name"
    ]
   },
   "UseCardTemplate": {
    "type": "object",
    "properties": {
     "list_id": {
      "type": "integer"
     },
     "card": {
      "type": "integer"
     },
     "builtin": {
      "enum": [
       "bug",
       "feature",
       "meeting"
      ]
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "list_id"
    ]
   },
   "NewWebhook": {
    "type": "object",
    "properties": {
     "url": {
      "type": "string",
      "description": "https address on the public internet"
     },
     "events": {
      "type": "array",
      "items": {
       "enum": [
        "card.created",
        "card.updated",
        "card.moved",
        "card.completed",
        "card.archived",
        "comment.created",
        "member.added",
        "board.created"
       ]
      }
     },
     "projects": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "description": "Leave out for all of your projects"
     }
    },
    "required": [
     "url",
     "events"
    ]
   },
   "WebhookChange": {
    "type": "object",
    "properties": {
     "active": {
      "type": "boolean"
     }
    },
    "required": [
     "active"
    ]
   }
  }
 },
 "security": [
  {
   "token": []
  }
 ],
